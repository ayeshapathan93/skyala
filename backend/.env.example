PORT=5000
MONGO_URI=mongodb://localhost:27017/skyala_db
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Single shop owner (auto-seeded on first start)
ADMIN_EMAIL=admin@skyla.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Shop Owner

# Business / Invoice header
BUSINESS_NAME=Skyla Organic & Herbal
BUSINESS_ADDRESS=At Bhoisamudraga, Post Harangul Bk
BUSINESS_CITY=Latur
BUSINESS_STATE=Maharashtra
BUSINESS_PINCODE=413531
BUSINESS_PHONE=9970603386
BUSINESS_PHONE2=9970338001
BUSINESS_TERMS=Add Your Terms and Conditions Here
BUSINESS_THANK_YOU=Thank you for your business!

# Frontend URLs (comma-separated for multiple origins)
# Local development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# For production, add your frontend URLs like:
# FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,https://skyala.vercel.app,https://your-frontend-domain.com

LOG_LEVEL=info
